    def _connect_signals(self):
        self.scheduler.queue_updated.connect(self._on_queue_updated)
        self.scheduler.task_status_changed.connect(self._on_node_status_changed)
        self.scheduler.rate_limit_detected.connect(self._show_rate_limit_toast)
        self.scheduler.sub_injector_telemetry.connect(
            lambda msg: self.train_chart_tab.set_progress(self.train_chart_tab.progress_bar.value(), msg)
        )
        self.scheduler.stage_dispatched.connect(self._on_stage_prompt_dispatched)
        self.task_table.clear_clicked.connect(self.scheduler.clear_completed)
        self.dom_watcher.generation_complete.connect(self._on_worker_generation_complete)
        self.train_chart_tab.relay_gate_approved.connect(self._on_relay_gate_approved)
        self.train_chart_tab.execution_mode_changed.connect(self._on_execution_mode_switched)
        self.train_chart_tab.force_stage_complete.connect(self._on_worker_generation_complete)

        self.mind_map_tab.session_selected.connect(self._on_session_history_selected)
        self.train_chart_tab.session_selected.connect(self._on_session_history_selected)

    def _on_queue_updated(self, tasks: list):
        self.task_table.update_tasks(tasks)
        if self.workspace_data and self.workspace_data.get("id"):
            self.project_mgr.save_task_history(self.workspace_data["id"], self.scheduler.serialize_tasks())

    def _save_or_update_current_session(self, create_new: bool = False, label_suffix: str = ""):
        if not self.accounts:
            return
        master_id = self.combo_master.currentData() or self.accounts[0]["id"]
        master_acc = next((a for a in self.accounts if a["id"] == master_id), self.accounts[0])
        workers = self.pipeline_worker_order or [a for a in self.accounts if a["id"] != master_id]

        if create_new or not self.pipeline_sessions:
            ts = datetime.now().strftime("%Y-%m-%d %I:%M:%S %p")
            session_num = len(self.pipeline_sessions) + 1
            title = f"Session #{session_num} - {ts} (Master: {master_acc['account_name']})"
            if label_suffix:
                title += f" [{label_suffix}]"
            snapshot = {
                "title": title,
                "master_account": master_acc,
                "worker_accounts": workers,
                "assigned_files": dict(self.assigned_files_display),
                "node_statuses": dict(self.current_node_statuses),
                "stage_statuses": dict(self.current_stage_statuses),
                "gate_states": list(self.current_gate_states)
            }
            self.pipeline_sessions.append(snapshot)
            self.viewing_session_idx = len(self.pipeline_sessions) - 1
        else:
            latest = self.pipeline_sessions[-1]
            latest["master_account"] = master_acc
            latest["worker_accounts"] = workers
            latest["assigned_files"] = dict(self.assigned_files_display)
            latest["node_statuses"] = dict(self.current_node_statuses)
            latest["stage_statuses"] = dict(self.current_stage_statuses)
            latest["gate_states"] = list(self.current_gate_states)
            self.viewing_session_idx = len(self.pipeline_sessions) - 1

        labels = [s["title"] for s in self.pipeline_sessions]
        self.mind_map_tab.set_session_list(labels, self.viewing_session_idx)
        self.train_chart_tab.set_session_list(labels, self.viewing_session_idx)

        if self.workspace_data and self.workspace_data.get("id"):
            self.project_mgr.save_pipeline_sessions(self.workspace_data["id"], self.pipeline_sessions)

    def _on_session_history_selected(self, idx: int):
        """Renders any historical or current session snapshot in the Mind-Map and Train Chart."""
        if not (0 <= idx < len(self.pipeline_sessions)):
            return
        self.viewing_session_idx = idx
        snap = self.pipeline_sessions[idx]

        labels = [s["title"] for s in self.pipeline_sessions]
        self.mind_map_tab.set_session_list(labels, idx)
        self.train_chart_tab.set_session_list(labels, idx)

        master_acc = snap.get("master_account") or (self.accounts[0] if self.accounts else {})
        workers = snap.get("worker_accounts") or []
        assigned_files = snap.get("assigned_files") or {}
        node_statuses = snap.get("node_statuses") or {}
        stage_statuses = snap.get("stage_statuses") or {}
        gate_states = snap.get("gate_states") or []

        self.mind_map_tab.build_mind_map(master_acc, workers, assigned_files, node_statuses)
        self.train_chart_tab.build_train_pipeline(workers, assigned_files, stage_statuses, gate_states)

        is_latest = (idx == len(self.pipeline_sessions) - 1)
        if not is_latest:
            self.train_chart_tab.set_progress(100, f"Viewing Historical Snapshot: {snap.get('title', '')}")

    def _clear_current_panes(self):
        for pane in self.panes.values():
            pane.cleanup()
            pane.deleteLater()
        self.panes.clear()
        while self.strip_layout.count():
            item = self.strip_layout.takeAt(0)
            if item.widget():
                item.widget().deleteLater()

    def _on_pane_url_changed(self, account_id: str, new_url: str):
        if not new_url or "login" in new_url.lower() or "accounts.google.com" in new_url.lower():
            return

        self.session_mgr.update_last_url(account_id, new_url)

        for acc in self.accounts:
            if acc.get("id") == account_id:
                acc["current_url"] = new_url
                acc["last_url"] = new_url
                break

        if self.workspace_data:
            proj_id = self.workspace_data.get("id")
            if proj_id:
                self.project_mgr.update_account_url(proj_id, account_id, new_url)
            else:
                self.workspace_data["accounts"] = self.accounts
                self.project_mgr.save_project(self.workspace_data)

    def _on_master_architect_changed(self, _index: int = 0):
        if not self.accounts:
            return
        master_id = self.combo_master.currentData()
        if not master_id:
            return

        self.active_master_id = master_id
        master_acc = next((a for a in self.accounts if a["id"] == master_id), self.accounts[0])
        workers = [a for a in self.accounts if a["id"] != master_id] or [master_acc]

        self.pipeline_worker_order = list(workers)
        self.assigned_files_display = {}
        self.current_node_statuses = {master_id: "idle"}
        self.current_stage_statuses = {w["id"]: "waiting" for w in workers}
        self.current_gate_states = [{"state": "locked", "files": []} for _ in range(max(0, len(workers) - 1))]

        self.mind_map_tab.build_mind_map(master_acc, workers)
        self.train_chart_tab.build_train_pipeline(workers)
        self._save_or_update_current_session(create_new=False)

    def _load_initial_workspace(self):
        self._clear_current_panes()

        if self.workspace_data and self.workspace_data.get("accounts"):
            proj_id = self.workspace_data.get("id")
            if proj_id:
                fresh = self.project_mgr.load_project(proj_id)
                if fresh:
                    self.workspace_data = fresh
            self.accounts = self.workspace_data["accounts"]
            self.project_name = self.workspace_data.get("name", "Untitled_Workspace")
        else:
            self.accounts = self.session_mgr.load_accounts()

        self.input_project_name.setText(self.project_name)
        self.setWindowTitle(f"Nexus AI Orchestrator - {self.project_name} [Swarm Workstation]")

        self.combo_target.blockSignals(True)
        self.combo_master.blockSignals(True)
        self.combo_target.clear()
        self.combo_master.clear()
        self.combo_target.addItem("Broadcast to All Active Nodes", "all")

        default_zoom = self.config.get("app", {}).get("default_zoom", 0.75)

        for acc in self.accounts:
            acc_id = acc["id"]
            platform = acc.get("platform", "claude").lower()
            plat_cfg = self.config.get("platforms", {}).get(platform, {})
            start_url = acc.get("current_url") or acc.get("last_url") or plat_cfg.get("home_url", "https://claude.ai/new")

            profile_key = acc.get("profile_id") or acc_id
            profile = self.session_mgr.get_or_create_profile(profile_key, self)
            pane = AIPane(acc_id, acc["account_name"], platform, profile, start_url, default_zoom, self)
            pane.url_changed.connect(self._on_pane_url_changed)
            pane.move_requested.connect(self._on_move_pane_requested)
            if hasattr(self, 'file_vault_tab'): self.file_vault_tab.refresh_targets_and_view()
            if hasattr(self, 'model_monitor_tab'): self.model_monitor_tab.rebuild_node_rows()

            self.strip_layout.addWidget(pane)
            self.panes[acc_id] = pane
            self.scheduler.register_pane(acc_id, pane, acc)

            label = f"{acc['account_name']} ({platform.capitalize()})"
            self.combo_target.addItem(label, acc_id)
            self.combo_master.addItem(label, acc_id)

        self.combo_target.blockSignals(False)
        self.combo_master.blockSignals(False)

        # 1. Restore Persistent Task Queue History from Project JSON
        saved_tasks = self.workspace_data.get("task_history", []) if self.workspace_data else []
        self.scheduler.load_serialized_tasks(saved_tasks)

        # 2. Restore Persistent Pipeline Session Graphs (Mind-Map & Train Chart)
        saved_sessions = self.workspace_data.get("pipeline_sessions", []) if self.workspace_data else []
        if saved_sessions:
            self.pipeline_sessions = list(saved_sessions)
            latest_idx = len(self.pipeline_sessions) - 1
            latest = self.pipeline_sessions[latest_idx]

            master_acc = latest.get("master_account") or (self.accounts[0] if self.accounts else {})
            m_idx = self.combo_master.findData(master_acc.get("id"))
            if m_idx >= 0:
                self.combo_master.blockSignals(True)
                self.combo_master.setCurrentIndex(m_idx)
                self.combo_master.blockSignals(False)

            self.pipeline_worker_order = latest.get("worker_accounts") or [
                a for a in self.accounts if a["id"] != master_acc.get("id")
            ]
            self.assigned_files_display = dict(latest.get("assigned_files") or {})
            self.current_node_statuses = dict(latest.get("node_statuses") or {})
            self.current_stage_statuses = dict(latest.get("stage_statuses") or {})
            self.current_gate_states = list(latest.get("gate_states") or [])

            self._on_session_history_selected(latest_idx)
        else:
            self.pipeline_sessions = []
            self._on_master_architect_changed()

        self.lbl_status_bar.setText(
            f"System Ready | Workspace: {self.project_name} | Active Nodes: {len(self.accounts)} (Horizontal Scroll Enabled) | Turnstile Poll: 2000ms"
        )

    def _open_project_hub(self):
        projects = self.project_mgr.load_projects() if hasattr(self.project_mgr, "load_projects") else []
        hub = ProjectHubDialog(projects, self)
        hub.open_project.connect(self._switch_to_workspace)
        hub.create_new_clicked.connect(self._open_onboarding_dialog)
        hub.exec()

    def _open_onboarding_dialog(self):
        dlg = OnboardingDialog(self, self.project_mgr)
        dlg.project_configured.connect(self._on_new_project_configured)
        dlg.exec()

    def _on_new_project_configured(self, proj_data: dict):
        self.project_mgr.save_project(proj_data)
        self._switch_to_workspace(proj_data)

    def _switch_to_workspace(self, proj_data: dict):
        self.workspace_data = proj_data
        self._load_initial_workspace()

    def _reload_all_nodes(self):
        for pane in self.panes.values():
            pane.reload_page()

    def _on_attach_file(self):
        file_path, _ = QFileDialog.getOpenFileName(self, "Select File to Attach", "", "All Files (*.*)")
        if file_path:
            self.attached_file_path = file_path
            self.btn_attach.setText(f"Attached: {os.path.basename(file_path)}")
            self.btn_attach.setStyleSheet("background-color: #065f46; color: #a7f3d0; border: 1px solid #10b981;")

    def _on_send_immediate(self):
        prompt = self.input_prompt.text().strip()
        if not prompt and not self.attached_file_path:
            return
        target_id = self.combo_target.currentData()
        self.scheduler.add_task(
            target_id=target_id,
            prompt=prompt,
            target_datetime=QDateTime.currentDateTime(),
            file_path=self.attached_file_path
        )
        self.input_prompt.clear()
        self.attached_file_path = None
        self.btn_attach.setText("Attach")
        self.btn_attach.setStyleSheet("")

    def _open_scheduler_dialog(self):
        dlg = TaskSchedulerDialog(self.accounts, self)
        dlg.task_scheduled.connect(
            lambda data: self.scheduler.add_task(
                target_id=data["target_id"],
                prompt=data["prompt"],
                target_datetime=data.get("target_datetime", QDateTime.currentDateTime()),
                file_path=data["file_path"]
            )
        )
        dlg.exec()

    def _on_send_master_directive(self):
        user_goal = self.input_prompt.text().strip()
        if not user_goal:
            QMessageBox.warning(self, "Missing Goal", "Enter your high-level project specification in the prompt bar.")
            return

        master_id = self.combo_master.currentData()
        self.active_master_id = master_id
        master_acc = next((a for a in self.accounts if a["id"] == master_id), self.accounts[0])
        worker_accounts = [a for a in self.accounts if a["id"] != master_id] or [master_acc]

        project_name = self.input_project_name.text().strip() or self.project_name
        directive = self.orchestrator.build_master_directive(user_goal, project_name, worker_accounts)

        self.pipeline_worker_order = list(worker_accounts)
        self.assigned_files_display = {}
        self.current_node_statuses = {master_id: "active"}
        self.current_stage_statuses = {w["id"]: "waiting" for w in worker_accounts}
        self.current_gate_states = [{"state": "locked", "files": []} for _ in range(max(0, len(worker_accounts) - 1))]

        self.mind_map_tab.build_mind_map(master_acc, worker_accounts, {}, self.current_node_statuses)
        self.train_chart_tab.build_train_pipeline(worker_accounts, {}, self.current_stage_statuses, self.current_gate_states)
        self._save_or_update_current_session(create_new=True, label_suffix="Directive Sent")
        self.bottom_tabs.setCurrentWidget(self.mind_map_tab)

        self.scheduler.add_task(master_id, directive, target_datetime=QDateTime.currentDateTime())
        self.input_prompt.clear()

    def _on_extract_and_delegate(self):
        master_id = self.combo_master.currentData()
        self.active_master_id = master_id
        if master_id not in self.panes:
            return

        master_pane = self.panes[master_id]
        DOMScraper.scrape_page_text(
            master_pane.get_page(),
            lambda raw_text: self._process_master_blueprint(master_id, raw_text)
        )

    def _process_master_blueprint(self, master_id: str, raw_text: str):
        master_acc = next((a for a in self.accounts if a["id"] == master_id), self.accounts[0])
        worker_accounts = [a for a in self.accounts if a["id"] != master_id] or [master_acc]
        valid_worker_ids = [a["id"] for a in worker_accounts]

        tasks_by_worker, routing_map, assigned_files_display = self.orchestrator.parse_master_response(
            raw_text, valid_worker_ids
        )

        if not tasks_by_worker:
            QMessageBox.warning(self, "No Tasks Found", "Could not find ===TASK_START=== blocks in the Master Node yet.")
            return

        self.harvester.set_project_map(routing_map)
        self.harvested_stage_files.clear()
        self.harvested_stage_summaries.clear()
        self.worker_tasks_prompts = dict(tasks_by_worker)
        self.assigned_files_display = dict(assigned_files_display)

        matched_workers = [a for a in worker_accounts if a["id"] in tasks_by_worker]
        self.pipeline_worker_order = matched_workers if matched_workers else list(worker_accounts)

        self.current_node_statuses = {master_id: "done"}
        self.current_stage_statuses = {w["id"]: "waiting" for w in self.pipeline_worker_order}
        self.current_gate_states = [
            {"state": "locked", "files": []} for _ in range(max(0, len(self.pipeline_worker_order) - 1))
        ]

        self.mind_map_tab.build_mind_map(
            master_acc, self.pipeline_worker_order, self.assigned_files_display, self.current_node_statuses
        )
        self.train_chart_tab.build_train_pipeline(
            self.pipeline_worker_order, self.assigned_files_display, self.current_stage_statuses, self.current_gate_states
        )
        self._save_or_update_current_session(create_new=True, label_suffix="Pipeline Delegated")

        self.bottom_tabs.setCurrentWidget(self.train_chart_tab)
        mode = self.train_chart_tab.get_execution_mode()

        for stage_idx, acc in enumerate(self.pipeline_worker_order):
            wid = acc["id"]
            if wid not in tasks_by_worker:
                continue
            prompt = tasks_by_worker[wid]
            hold_gate = (mode == "pipeline" and stage_idx > 0)

            self.scheduler.add_task(
                target_id=wid,
                prompt=prompt,
                target_datetime=QDateTime.currentDateTime(),
                hold_for_gate=hold_gate,
                stage_index=stage_idx
            )

        if mode == "pipeline" and self.pipeline_worker_order:
            first_name = self.pipeline_worker_order[0]["account_name"]
            self.train_chart_tab.set_progress(10, f"Stage 1 Dispatched -> {first_name}")
        else:
            self.train_chart_tab.set_progress(25, "Parallel Swarm Dispatched (2s Turnstile)")

    def _on_stage_prompt_dispatched(self, account_id: str):
        if account_id not in self.panes:
            return
        if account_id == self.combo_master.currentData():
            self.current_node_statuses[account_id] = "active"
            self.mind_map_tab.update_node_status(account_id, "active")
            self._save_or_update_current_session(create_new=False)
            return

        acc = next((a for a in self.accounts if a["id"] == account_id), None)
        if not acc:
            return

        self.current_node_statuses[account_id] = "active"
        self.current_stage_statuses[account_id] = "running"
        self.mind_map_tab.update_node_status(account_id, "active")
        self.train_chart_tab.set_stage_status(account_id, "running")
        self._save_or_update_current_session(create_new=False)

        self.dom_watcher.start_watching(
            account_id=account_id, page=self.panes[account_id].get_page(),
            platform=acc["platform"], config=self.config
        )

    def _on_worker_generation_complete(self, account_id: str):
        self.dom_watcher.stop_watching(account_id)
        if account_id not in self.panes:
            return

        pane = self.panes[account_id]
        DOMScraper.scrape_page_text(
            pane.get_page(),
            lambda raw_text: self._harvest_stage_and_trigger_gate(account_id, raw_text)
        )

    def _build_cumulative_gate_file_entries(self, up_to_stage_idx: int) -> list:
        """
        Gathers ALL files harvested from Stage 1 up to up_to_stage_idx.
        Marks files as [Recommended] if:
          - They are explicitly mentioned in the next stage's Master task prompt, OR
          - They were produced by the immediately preceding stage (if no specific filename was mentioned).
        """
        next_stage_idx = up_to_stage_idx + 1
        next_prompt = ""
        if next_stage_idx < len(self.pipeline_worker_order):
            next_wid = self.pipeline_worker_order[next_stage_idx]["id"]
            next_prompt = (self.worker_tasks_prompts.get(next_wid) or "").lower()

        entries = []
        any_prompt_match = False

        for s_idx in range(up_to_stage_idx + 1):
            if s_idx >= len(self.pipeline_worker_order):
                break
            w_acc = self.pipeline_worker_order[s_idx]
            w_id = w_acc["id"]
            w_name = w_acc["account_name"]
            files = self.harvested_stage_files.get(w_id, [])

            for f_path in files:
                fname = os.path.basename(f_path)
                mentioned_in_next = bool(next_prompt and fname.lower() in next_prompt)
                if mentioned_in_next:
                    any_prompt_match = True
                entries.append({
                    "path": f_path,
                    "filename": fname,
                    "stage_num": s_idx + 1,
                    "account_name": w_name,
                    "mentioned": mentioned_in_next,
                    "from_immediate_prev": (s_idx == up_to_stage_idx),
                    "recommended": False
                })

        for entry in entries:
            if any_prompt_match:
                entry["recommended"] = entry["mentioned"] or entry["from_immediate_prev"]
            else:
                entry["recommended"] = entry["from_immediate_prev"]

        return entries

    def _harvest_stage_and_trigger_gate(self, account_id: str, raw_text: str):
        project_name = self.input_project_name.text().strip() or self.project_name
        created_files = self.harvester.parse_and_write_files(raw_text, project_name, account_id)
        summary_text = self.harvester.extract_summary(raw_text)

        self.harvested_stage_files[account_id] = created_files
        self.harvested_stage_summaries[account_id] = summary_text

        self.current_node_statuses[account_id] = "done"
        self.current_stage_statuses[account_id] = "completed"
        self.mind_map_tab.update_node_status(account_id, "done")
        self.train_chart_tab.set_stage_status(account_id, "completed")

        stage_indices = [i for i, a in enumerate(self.pipeline_worker_order) if a["id"] == account_id]
        if not stage_indices:
            self._save_or_update_current_session(create_new=False)
            return

        curr_idx = stage_indices[0]
        total_stages = len(self.pipeline_worker_order)

        if curr_idx < total_stages - 1:
            cumulative_entries = self._build_cumulative_gate_file_entries(curr_idx)
            while len(self.current_gate_states) <= curr_idx:
                self.current_gate_states.append({"state": "locked", "files": []})
            self.current_gate_states[curr_idx] = {
                "state": "awaiting_approval" if self.train_chart_tab.is_pause_for_approval() else "relayed",
                "files": cumulative_entries
            }
            self._save_or_update_current_session(create_new=False)

            if self.train_chart_tab.get_execution_mode() == "pipeline":
                self.train_chart_tab.activate_gate(curr_idx, cumulative_entries)
        else:
            self._save_or_update_current_session(create_new=False)
            zip_path = self.harvester.create_project_zip(project_name)
            self.train_chart_tab.set_progress(100, f"Pipeline Complete! Built Archive: {os.path.basename(zip_path)}")

    def _on_relay_gate_approved(self, gate_index: int, payload: dict):
        if gate_index + 1 >= len(self.pipeline_worker_order):
            return

        if 0 <= gate_index < len(self.current_gate_states):
            self.current_gate_states[gate_index]["state"] = "relayed"
            self._save_or_update_current_session(create_new=False)

        upstream_acc = self.pipeline_worker_order[gate_index]
        downstream_acc = self.pipeline_worker_order[gate_index + 1]

        send_summary = payload.get("send_summary", False)
        selected_files = payload.get("files", [])

        summary_to_inject = self.harvested_stage_summaries.get(upstream_acc["id"], "") if send_summary else ""

        pct = int(((gate_index + 1) / len(self.pipeline_worker_order)) * 100)
        self.train_chart_tab.set_progress(pct, f"Relaying {len(selected_files)} file(s) -> {downstream_acc['account_name']}...")

        self.scheduler.release_stage_task(
            account_id=downstream_acc["id"],
            appended_summary=summary_to_inject,
            relay_files=selected_files
        )

    def _on_execution_mode_switched(self, mode: str):
        if mode == "parallel":
            self.scheduler.release_all_held_tasks()
            self.train_chart_tab.set_progress(50, "Switched to Parallel Swarm - All Held Stages Released")

    def _on_harvest_all_nodes(self):
        project_name = self.input_project_name.text().strip() or self.project_name
        master_id = self.combo_master.currentData()
        worker_ids = [a["id"] for a in self.accounts if a["id"] != master_id] or [master_id]

        remaining = len(worker_ids)
        all_written = []

        def _on_scraped(acc_id, text):
            nonlocal remaining
            files = self.harvester.parse_and_write_files(text, project_name, acc_id)
            all_written.extend(files)
            remaining -= 1
            if remaining == 0:
                zip_path = self.harvester.create_project_zip(project_name)
                self.train_chart_tab.set_progress(100, f"Harvested {len(all_written)} files -> {os.path.basename(zip_path)}")
                QMessageBox.information(
                    self, "Workspace Harvested & Zipped",
                    f"Harvested {len(all_written)} files into:\n{self.harvester.get_project_build_dir(project_name)}\n\n"
                    f"Compiled Archive:\n{zip_path}"
                )

        for wid in worker_ids:
            if wid in self.panes:
                DOMScraper.scrape_page_text(self.panes[wid].get_page(), lambda txt, w=wid: _on_scraped(w, txt))

    def _on_node_status_changed(self, account_id: str, status: str):
        if account_id in self.panes:
            self.panes[account_id].set_status(status)

    def _show_rate_limit_toast(self, account_id: str, account_name: str, platform: str, resets_at: str):
        toast = RateLimitToast(account_id, account_name, platform, resets_at, self.toast_container)
        toast.auto_resume_clicked.connect(self.scheduler.schedule_auto_resume)
        self.toast_layout.addWidget(toast)
        self.toast_container.adjustSize()
        self.toast_container.move(
            self.width() - self.toast_container.width() - 20,
            self.height() - self.toast_container.height() - 20
        )
        self.toast_container.show()

    def _get_active_project_dict(self):
        for attr in ("active_project", "current_project", "workspace_data", "project_data"):
            val = getattr(self, attr, None)
            if isinstance(val, dict):
                return val
        if not hasattr(self, "_fallback_project_dict"):
            self._fallback_project_dict = {
                "project_id": "proj_local",
                "name": "Workspace",
                "accounts": [],
                "file_vault": {"files": [], "folders": []}
            }
        return self._fallback_project_dict

    def _get_strip_layout(self, pane_widget=None):
        for attr in ("browser_strip_layout", "strip_layout", "panes_layout", "hbox_panes", "workspace_layout"):
            lay = getattr(self, attr, None)
            if lay is not None and hasattr(lay, "indexOf"):
                return lay
        if pane_widget is not None and pane_widget.parentWidget() and pane_widget.parentWidget().layout():
            return pane_widget.parentWidget().layout()
        return None

    def _on_move_pane_requested(self, account_id: str, direction: int):
        if account_id not in self.panes:
            return
        pane_keys = list(self.panes.keys())
        idx = pane_keys.index(account_id)
        new_idx = idx + direction
        if new_idx < 0 or new_idx >= len(pane_keys):
            return

        pane_widget = self.panes[account_id]
        lay = self._get_strip_layout(pane_widget)
        if lay is not None:
            lay.removeWidget(pane_widget)
            lay.insertWidget(new_idx, pane_widget)

        pane_keys[idx], pane_keys[new_idx] = pane_keys[new_idx], pane_keys[idx]
        self.panes = {k: self.panes[k] for k in pane_keys}

        proj = self._get_active_project_dict()
        accounts = proj.get("accounts", [])
        if len(accounts) == len(pane_keys):
            acc_map = {a.get("id"): a for a in accounts}
            if all(k in acc_map for k in pane_keys):
                proj["accounts"] = [acc_map[k] for k in pane_keys]
        proj["_is_dirty"] = True

        if hasattr(self, "model_monitor_tab"):
            self.model_monitor_tab.rebuild_node_rows()
        if hasattr(self, "file_vault_tab"):
            self.file_vault_tab.refresh_targets_and_view()
        self._refresh_relay_vault_bar()

        # Remove any horizontal spacer items in the browser strip layout so 2-3 panes expand to 100% width
        if getattr(self, "panes", None):
            first_pane = next(iter(self.panes.values()))
            strip_lay = self._get_strip_layout(first_pane)
            if strip_lay is not None:
                for i in reversed(range(strip_lay.count())):
                    item = strip_lay.itemAt(i)
                    if item and item.spacerItem() is not None:
                        strip_lay.takeAt(i)
                for p in self.panes.values():
                    strip_lay.setStretchFactor(p, 1)

        self._enhance_mind_map_zoom_and_fit()
        self._refresh_relay_stage_reorder_list()

    def _snapshot_current_project_state(self):
        proj = self._get_active_project_dict()
        if not proj:
            return
        if not proj.get("accounts"):
            proj["accounts"] = []
            for aid, pane in getattr(self, "panes", {}).items():
                proj["accounts"].append({
                    "id": aid,
                    "profile_id": aid,
                    "account_name": pane.account_name,
                    "platform": pane.platform,
                    "current_url": pane.web_view.url().toString()
                })
        else:
            for acc in proj.get("accounts", []):
                acc_id = acc.get("id")
                if acc_id in self.panes:
                    curr_u = self.panes[acc_id].web_view.url().toString()
                    if curr_u and "login" not in curr_u.lower() and "accounts.google.com" not in curr_u.lower():
                        acc["current_url"] = curr_u
        if hasattr(self, "combo_master") and self.combo_master.currentData():
            proj["master_node_id"] = self.combo_master.currentData()
        if hasattr(self, "train_chart") and hasattr(self.train_chart, "sessions"):
            proj["pipeline_sessions"] = self.train_chart.sessions

    def _action_save_project(self) -> bool:
        """Saves project details locally inside the software's internal Project Hub vault (NO file dialog)."""
        proj = self._get_active_project_dict()
        if not proj:
            return False
        self._snapshot_current_project_state()
        # Ensure internal vault path only (clear any external _file_path override so it saves internally)
        proj["_is_saved"] = True
        proj["_is_dirty"] = False
        saved_path = self.project_mgr.save_project(proj, force_disk=True)
        proj_name = proj.get("name", "Workspace")
        self.setWindowTitle(f"Nexus AI Orchestrator - {proj_name} [Saved in Software]")
        if hasattr(self, "_notify"):
            self._notify("Saved in Software", f"Project '{proj_name}' saved to internal workspace vault.", "completed")
        else:
            QMessageBox.information(self, "Project Saved", f"Project '{proj_name}' has been saved locally in the software.")
        return True

    def _action_save_project_as(self) -> bool:
        """Exports the complete project state into an external .json file chosen by the user."""
        proj = self._get_active_project_dict()
        if not proj:
            return False
        self._snapshot_current_project_state()
        default_name = f"{proj.get('name', 'workspace')}.json"
        file_path, _ = QFileDialog.getSaveFileName(
            self,
            "Export Project Workspace As JSON File",
            default_name,
            "JSON Project Files (*.json)"
        )
        if not file_path:
            return False
        if not file_path.lower().endswith(".json"):
            file_path += ".json"
        proj["name"] = os.path.splitext(os.path.basename(file_path))[0]
        saved_path = self.project_mgr.save_project(
            proj, force_disk=True, custom_file_path=file_path
        )
        if hasattr(self, "lbl_proj_badge"):
            self.lbl_proj_badge.setText(proj["name"])
        self.setWindowTitle(f"Nexus AI Orchestrator - {proj['name']} [Exported JSON]")
        if hasattr(self, "_notify"):
            self._notify("Exported JSON", f"Complete project exported to {saved_path}", "completed")
        return True

    def _action_open_project_json(self):
        if not self._confirm_unsaved_project():
            return
        file_path, _ = QFileDialog.getOpenFileName(
            self,
            "Open Saved Project JSON",
            "",
            "JSON Project Files (*.json)"
        )
        if not file_path:
            return
        proj = self.project_mgr.load_project_from_file(file_path)
        if not proj:
            QMessageBox.critical(self, "Open Failed", "Could not parse the selected Project JSON file.")
            return
        for attr in ("active_project", "current_project", "workspace_data"):
            if hasattr(self, attr):
                setattr(self, attr, proj)
        if hasattr(self, "_mount_project"):
            self._mount_project(proj)
        elif hasattr(self, "_load_initial_workspace"):
            self._load_initial_workspace()
        if hasattr(self, "train_chart") and "pipeline_sessions" in proj:
            try:
                self.train_chart.sessions = proj.get("pipeline_sessions", [])
            except Exception:
                pass
        if hasattr(self, "file_vault_tab"):
            self.file_vault_tab.refresh_targets_and_view()
        if hasattr(self, "model_monitor_tab"):
            self.model_monitor_tab.rebuild_node_rows()
        self._refresh_relay_vault_bar()

        # Remove any horizontal spacer items in the browser strip layout so 2-3 panes expand to 100% width
        if getattr(self, "panes", None):
            first_pane = next(iter(self.panes.values()))
            strip_lay = self._get_strip_layout(first_pane)
            if strip_lay is not None:
                for i in reversed(range(strip_lay.count())):
                    item = strip_lay.itemAt(i)
                    if item and item.spacerItem() is not None:
                        strip_lay.takeAt(i)
                for p in self.panes.values():
                    strip_lay.setStretchFactor(p, 1)

        self._enhance_mind_map_zoom_and_fit()
        self._refresh_relay_stage_reorder_list()
        if hasattr(self, "_notify"):
            self._notify("Project Loaded", f"Restored workspace '{proj.get('name')}' from JSON.", "completed")

    def _confirm_unsaved_project(self) -> bool:
        proj = self._get_active_project_dict()
        if not proj:
            return True

        proj_name = proj.get("name", "Untitled")
        msg = QMessageBox(self)
        msg.setWindowTitle("Save Project Locally in Software?")
        msg.setIcon(QMessageBox.Icon.Question)
        msg.setText(f"Do you want to save project '{proj_name}' locally in Nexus AI Orchestrator before closing?")
        msg.setInformativeText(
            "Clicking 'Save in Software' stores all chat URLs, attached vault files, and pipeline state inside your internal Project Hub."
        )
        btn_save = msg.addButton("Save in Software", QMessageBox.ButtonRole.AcceptRole)
        btn_export = msg.addButton("Export JSON (Save As...)", QMessageBox.ButtonRole.ActionRole)
        btn_discard = msg.addButton("Don't Save", QMessageBox.ButtonRole.DestructiveRole)
        btn_cancel = msg.addButton("Cancel", QMessageBox.ButtonRole.RejectRole)
        msg.exec()

        clicked = msg.clickedButton()
        if clicked == btn_save:
            return self._action_save_project()
        elif clicked == btn_export:
            return self._action_save_project_as()
        elif clicked == btn_discard:
            return True
        return False

    def _find_relay_tab_widget(self):
        from PyQt6.QtWidgets import QTabWidget
        for tw in self.findChildren(QTabWidget):
            for i in range(tw.count()):
                if "Execution Flow" in tw.tabText(i):
                    return tw.widget(i)
        return getattr(self, "train_chart", None)

    def _inject_relay_vault_bar(self, target_tab_widget):
        """Injects ONLY the single Relay Stage Vault Files bar and attaches compact [◀] [▶] arrows to each Stage Card."""
        from PyQt6.QtWidgets import QFrame, QHBoxLayout, QLabel, QComboBox, QPushButton
        from PyQt6.QtCore import QTimer

        relay_widget = None
        for i in range(target_tab_widget.count()):
            if "Execution Flow" in target_tab_widget.tabText(i):
                relay_widget = target_tab_widget.widget(i)
                break
        if relay_widget is None or getattr(self, "_relay_vault_bar_mounted", False):
            return
        self._relay_widget_ref = relay_widget

        lay = relay_widget.layout()
        if lay is None:
            return

        bar = QFrame(relay_widget)
        bar.setStyleSheet("""
            QFrame { background-color: #141417; border: 1px solid #27272a; border-radius: 4px; }
            QLabel { color: #f4f4f5; font-size: 11px; font-weight: bold; border: none; }
            QComboBox { background-color: #09090b; color: #f4f4f5; border: 1px solid #3f3f46; border-radius: 3px; padding: 3px 8px; font-size: 11px; font-weight: bold; }
            QPushButton { background-color: #2563eb; color: #ffffff; border: 1px solid #3b82f6; border-radius: 3px; padding: 4px 10px; font-size: 11px; font-weight: bold; }
            QPushButton:hover:enabled { background-color: #1d4ed8; }
        """)
        hl = QHBoxLayout(bar)
        hl.setContentsMargins(8, 5, 8, 5)
        hl.setSpacing(6)

        lbl_title = QLabel("\U0001f4ce Relay Stage Vault Files:")
        self.combo_relay_files = QComboBox()
        self.combo_relay_files.setMinimumWidth(260)

        lbl_stage = QLabel("-> Target Stage Chat:")
        self.combo_relay_stage_target = QComboBox()
        self.combo_relay_stage_target.setMinimumWidth(180)

        btn_upload_stage = QPushButton("\U0001f680 Upload File(s) to Stage")
        btn_upload_stage.clicked.connect(self._on_upload_recommended_from_relay_tab)

        btn_upload_all_rec = QPushButton("\u26a1 Auto-Upload All Requested Files")
        btn_upload_all_rec.setStyleSheet("background-color: #059669; border: 1px solid #10b981;")
        btn_upload_all_rec.clicked.connect(
            lambda: self.file_vault_tab.upload_all_recommended_to_requesting_chats() if hasattr(self, "file_vault_tab") else None
        )

        hl.addWidget(lbl_title)
        hl.addWidget(self.combo_relay_files, stretch=1)
        hl.addWidget(lbl_stage)
        hl.addWidget(self.combo_relay_stage_target)
        hl.addWidget(btn_upload_stage)
        hl.addWidget(btn_upload_all_rec)

        lay.insertWidget(0, bar)
        self._relay_vault_bar_mounted = True

        # Hook into relay_widget methods so compact [◀] [▶] arrows stay attached whenever stages rebuild
        for method_name in ("_render_session", "_build_pipeline_ui", "load_blueprint_session", "refresh_ui", "_populate_stages", "update_stage_status"):
            if hasattr(relay_widget, method_name) and not getattr(relay_widget, f"_hooked_compact_{method_name}", False):
                orig_fn = getattr(relay_widget, method_name)
                def _make_wrap(fn):
                    def _wrapped(*a, **kw):
                        res = fn(*a, **kw)
                        QTimer.singleShot(50, self._refresh_relay_stage_reorder_list)
                        return res
                    return _wrapped
                setattr(relay_widget, method_name, _make_wrap(orig_fn))
                setattr(relay_widget, f"_hooked_compact_{method_name}", True)

        self._refresh_relay_vault_bar()
        QTimer.singleShot(250, self._refresh_relay_stage_reorder_list)

    def _get_relay_stage_cards_and_data(self):
        """Finds all STAGE N cards sorted strictly by their true layout index in parent_lay (never stale screen coords)."""
        from PyQt6.QtWidgets import QLabel, QComboBox
        relay_widget = getattr(self, "_relay_widget_ref", None) or self._find_relay_tab_widget()
        if relay_widget is None:
            return [], None

        for cmb in relay_widget.findChildren(QComboBox):
            for idx in range(cmb.count()):
                t = cmb.itemText(idx)
                if "\u00e2\u20ac\u201d" in t or "\u2014" in t:
                    cmb.setItemText(idx, t.replace("\u00e2\u20ac\u201d", "-").replace("\u2014", "-"))

        raw_entries = []
        for lbl in relay_widget.findChildren(QLabel):
            txt = (lbl.text() or "").strip()
            if txt.startswith("STAGE ") and ":" in txt:
                parent_w = lbl.parentWidget()
                if parent_w and parent_w.objectName() == "SingleCompactStageHeader":
                    card_widget = parent_w.parentWidget()
                else:
                    card_widget = parent_w
                if card_widget is None:
                    continue
                strip_parent = card_widget.parentWidget()
                strip_lay = strip_parent.layout() if strip_parent else None
                lay_idx = strip_lay.indexOf(card_widget) if strip_lay is not None else 0
                raw_entries.append((lay_idx, lbl, card_widget))

        # Sort strictly by actual layout index inside the horizontal pipeline layout!
        raw_entries.sort(key=lambda item: item[0])

        cards = []
        for sequential_idx, (lay_idx, lbl, card_widget) in enumerate(raw_entries):
            status_txt = "WAITING"
            for child_lbl in card_widget.findChildren(QLabel):
                ct = (child_lbl.text() or "").strip().upper()
                if ct.startswith("STATUS:"):
                    status_txt = ct.replace("STATUS:", "").strip()
                    break
            stage_name = lbl.text().split(":", 1)[1].strip()
            # Keep STAGE number in sync with its true sequential position (STAGE 1, STAGE 2, STAGE 3...)
            lbl.setText(f"STAGE {sequential_idx + 1}: {stage_name}")
            cards.append({
                "index": sequential_idx,
                "layout_index": lay_idx,
                "title_label": lbl,
                "card_widget": card_widget,
                "stage_name": stage_name,
                "status": status_txt
            })

        return cards, relay_widget

    def _refresh_relay_stage_reorder_list(self):
        cards, _ = self._get_relay_stage_cards_and_data()
        if not cards:
            return
        self._embed_compact_arrows_on_stage_cards(cards)

    def _embed_compact_arrows_on_stage_cards(self, cards):
        from PyQt6.QtWidgets import QWidget, QHBoxLayout, QPushButton
        total = len(cards)
        for i, c in enumerate(cards):
            card_w = c["card_widget"]
            lbl = c["title_label"]
            card_lay = card_w.layout() if card_w else None
            if not card_w or not card_lay:
                continue

            is_idle = c["status"] in ("WAITING", "IDLE", "PENDING", "READY")

            for old_name in ("StageReorderBar", "InlineStageMoveBar"):
                for old_w in card_w.findChildren(QWidget, old_name):
                    card_lay.removeWidget(old_w)
                    old_w.setParent(None)
                    old_w.deleteLater()

            header_bar = card_w.findChild(QWidget, "SingleCompactStageHeader")
            if header_bar is None:
                header_bar = QWidget(card_w)
                header_bar.setObjectName("SingleCompactStageHeader")
                hl = QHBoxLayout(header_bar)
                hl.setContentsMargins(0, 0, 0, 2)
                hl.setSpacing(6)

                btn_left = QPushButton("\u25c0", header_bar)
                btn_left.setObjectName("BtnStageLeft")
                btn_left.setFixedWidth(22)
                btn_left.setFixedHeight(20)
                btn_left.setToolTip("Swap Stage with Left Neighbor")

                btn_right = QPushButton("\u25b6", header_bar)
                btn_right.setObjectName("BtnStageRight")
                btn_right.setFixedWidth(22)
                btn_right.setFixedHeight(20)
                btn_right.setToolTip("Swap Stage with Right Neighbor")

                arrow_style = """
                    QPushButton { background-color: #27272a; color: #e4e4e7; border: 1px solid #3f3f46; border-radius: 2px; padding: 0px; font-size: 10px; font-weight: bold; }
                    QPushButton:hover:enabled { background-color: #ea580c; border-color: #f97316; color: #ffffff; }
                    QPushButton:disabled { background-color: #121215; color: #3f3f46; border: 1px solid #27272a; }
                """
                btn_left.setStyleSheet(arrow_style)
                btn_right.setStyleSheet(arrow_style)

                card_lay.removeWidget(lbl)
                hl.addWidget(btn_left)
                hl.addWidget(lbl, stretch=1)
                hl.addWidget(btn_right)
                card_lay.insertWidget(0, header_bar)
            else:
                btn_left = header_bar.findChild(QPushButton, "BtnStageLeft")
                btn_right = header_bar.findChild(QPushButton, "BtnStageRight")

            # First card (i == 0): Left arrow disabled. Last card (i == total - 1): Right arrow disabled.
            can_move_left = is_idle and (i > 0)
            can_move_right = is_idle and (i < total - 1)

            if btn_left is not None:
                try:
                    btn_left.clicked.disconnect()
                except Exception:
                    pass
                btn_left.setEnabled(can_move_left)
                if can_move_left:
                    btn_left.clicked.connect(lambda _, cur=i: self._swap_relay_stages(cur, cur - 1))

            if btn_right is not None:
                try:
                    btn_right.clicked.disconnect()
                except Exception:
                    pass
                btn_right.setEnabled(can_move_right)
                if can_move_right:
                    btn_right.clicked.connect(lambda _, cur=i: self._swap_relay_stages(cur, cur + 1))

    def _swap_relay_stages(self, idx_a: int, idx_b: int):
        from PyQt6.QtWidgets import QMessageBox
        cards, relay_widget = self._get_relay_stage_cards_and_data()
        if not cards or idx_a < 0 or idx_b < 0 or idx_a >= len(cards) or idx_b >= len(cards):
            return

        card_a = cards[idx_a]
        card_b = cards[idx_b]

        for c in (card_a, card_b):
            if c["status"] not in ("WAITING", "IDLE", "PENDING", "READY"):
                QMessageBox.warning(
                    self,
                    "Stage In Use",
                    f"Cannot move STAGE {c['index'] + 1} ({c['stage_name']}) because its status is '{c['status']}'."
                )
                return

        # 1. Swap in underlying session / stage data lists
        if relay_widget is not None:
            for attr_name in dir(relay_widget):
                if attr_name.startswith("__"):
                    continue
                try:
                    val = getattr(relay_widget, attr_name)
                except Exception:
                    continue
                if isinstance(val, list) and len(val) == len(cards):
                    val[idx_a], val[idx_b] = val[idx_b], val[idx_a]
                elif isinstance(val, list) and val and isinstance(val[0], dict):
                    for sess in val:
                        if isinstance(sess, dict):
                            for k, v in sess.items():
                                if isinstance(v, list) and len(v) == len(cards):
                                    v[idx_a], v[idx_b] = v[idx_b], v[idx_a]

        # 2. Swap the two adjacent stage cards inside the horizontal layout
        w_a = card_a["card_widget"]
        w_b = card_b["card_widget"]
        parent_lay = w_a.parentWidget().layout() if (w_a and w_a.parentWidget()) else None
        if parent_lay is not None:
            pos_a = parent_lay.indexOf(w_a)
            pos_b = parent_lay.indexOf(w_b)
            if pos_a != -1 and pos_b != -1:
                if pos_a < pos_b:
                    parent_lay.removeWidget(w_b)
                    parent_lay.removeWidget(w_a)
                    parent_lay.insertWidget(pos_a, w_b)
                    parent_lay.insertWidget(pos_b, w_a)
                else:
                    parent_lay.removeWidget(w_a)
                    parent_lay.removeWidget(w_b)
                    parent_lay.insertWidget(pos_b, w_a)
                    parent_lay.insertWidget(pos_a, w_b)

        # 3. Immediately re-read layout order and update STAGE numbers + left/right disabled states
        self._refresh_relay_stage_reorder_list()

    def _refresh_relay_vault_bar(self, recs=None):
        if not hasattr(self, "combo_relay_files") or not hasattr(self, "combo_relay_stage_target"):
            return
        proj = self._get_active_project_dict()
        vault = proj.setdefault("file_vault", {"files": [], "folders": []})
        all_files = vault.get("files", [])

        self.combo_relay_files.clear()
        if not all_files:
            self.combo_relay_files.addItem("(No files in Project Vault yet - attach in Project Files tab)", None)
        else:
            rec_files = [f for f in all_files if f.get("requested_by_nodes") or "Recommended" in f.get("planned_usage", "")]
            if rec_files:
                self.combo_relay_files.addItem(f"\u2605 All Recommended/Requested Files ({len(rec_files)} files)", "__all_rec__")
            self.combo_relay_files.addItem(f"All Vault Files ({len(all_files)} files)", "__all_vault__")
            for f in all_files:
                tag = f.get("planned_usage", "Ready")
                self.combo_relay_files.addItem(f"{f['name']}  [{tag}]", f["path"])

        self.combo_relay_stage_target.clear()
        for aid, pane in getattr(self, "panes", {}).items():
            self.combo_relay_stage_target.addItem(f"Stage: {pane.account_name} [{pane.platform.capitalize()}]", aid)

        self._refresh_relay_stage_reorder_list()

    def _on_upload_recommended_from_relay_tab(self):
        if not hasattr(self, "combo_relay_files") or not hasattr(self, "file_vault_tab"):
            return
        choice = self.combo_relay_files.currentData()
        target_aid = self.combo_relay_stage_target.currentData()
        panes = getattr(self, "panes", {})
        if not choice or target_aid not in panes:
            return

        proj = self._get_active_project_dict()
        all_files = proj.get("file_vault", {}).get("files", [])
        if choice == "__all_rec__":
            paths = [f["path"] for f in all_files if (f.get("requested_by_nodes") or "Recommended" in f.get("planned_usage", "")) and os.path.exists(f["path"])]
        elif choice == "__all_vault__":
            paths = [f["path"] for f in all_files if os.path.exists(f["path"])]
        else:
            paths = [choice] if os.path.exists(choice) else []

        if not paths:
            return

        pane = panes[target_aid]
        self.file_vault_tab.injector.send_multi_files(
            page=pane.get_page(),
            platform=pane.platform,
            prompt_text="Attached recommended project file(s) for this execution stage.",
            file_paths=paths,
            view=pane.web_view
        )

    def _enhance_mind_map_zoom_and_fit(self):
        """Upgrades the Task Assignment Mind-Map QGraphicsView with two-finger touchpad zoom, classic +/- buttons, and 1.0x readable Center/Fit."""
        from PyQt6.QtWidgets import QGraphicsView, QPushButton, QHBoxLayout
        from PyQt6.QtCore import Qt, QEvent, QObject
        from PyQt6.QtGui import QPainter, QNativeGestureEvent

        if getattr(self, "_mind_map_enhanced", False):
            return

        views = self.findChildren(QGraphicsView)
        if not views:
            return
        gv = views[0]
        self._mind_map_gv = gv

        gv.setRenderHints(QPainter.RenderHint.Antialiasing | QPainter.RenderHint.TextAntialiasing | QPainter.RenderHint.SmoothPixmapTransform)
        gv.setTransformationAnchor(QGraphicsView.ViewportAnchor.AnchorUnderMouse)
        gv.setResizeAnchor(QGraphicsView.ViewportAnchor.AnchorUnderMouse)
        gv.setDragMode(QGraphicsView.DragMode.ScrollHandDrag)
        gv.viewport().setAttribute(Qt.WidgetAttribute.WA_AcceptTouchEvents, True)
        gv.grabGesture(Qt.GestureType.PinchGesture)

        class _ClassicMindMapZoomFilter(QObject):
            def __init__(self, view):
                super().__init__(view)
                self.view = view

            def _apply_zoom_factor(self, factor: float):
                curr_scale = self.view.transform().m11()
                if (curr_scale < 0.35 and factor < 1.0) or (curr_scale > 3.5 and factor > 1.0):
                    return
                self.view.scale(factor, factor)

            def eventFilter(self, obj, event):
                etype = event.type()
                if etype == QEvent.Type.NativeGesture:
                    if isinstance(event, QNativeGestureEvent):
                        if event.gestureType() == Qt.NativeGestureType.ZoomNativeGesture:
                            val = event.value()
                            factor = 1.0 + val
                            if 0.5 < factor < 2.0:
                                self._apply_zoom_factor(factor)
                            return True
                elif etype == QEvent.Type.Gesture:
                    pinch = event.gesture(Qt.GestureType.PinchGesture)
                    if pinch is not None:
                        sf = pinch.scaleFactor()
                        if 0.5 < sf < 2.0:
                            self._apply_zoom_factor(sf)
                        return True
                elif etype == QEvent.Type.Wheel:
                    angle = event.angleDelta().y()
                    if angle == 0:
                        angle = event.pixelDelta().y()
                    if angle != 0:
                        step = 1.12 if angle > 0 else (1.0 / 1.12)
                        self._apply_zoom_factor(step)
                        event.accept()
                        return True
                return False

        self._mm_zoom_filter = _ClassicMindMapZoomFilter(gv)
        gv.installEventFilter(self._mm_zoom_filter)
        gv.viewport().installEventFilter(self._mm_zoom_filter)

        def _readable_center_fit():
            scene = gv.scene()
            if not scene:
                return
            rect = scene.itemsBoundingRect()
            if rect.isEmpty():
                return
            gv.resetTransform()
            vp = gv.viewport().rect()
            if vp.width() > 50 and vp.height() > 50 and rect.width() > 0 and rect.height() > 0:
                sx = (vp.width() - 40) / rect.width()
                sy = (vp.height() - 40) / rect.height()
                target_scale = min(sx, sy, 1.05)
                readable_scale = max(0.92, target_scale)
                gv.scale(readable_scale, readable_scale)
            gv.centerOn(rect.center())

        self._readable_center_fit = _readable_center_fit

        for btn in self.findChildren(QPushButton):
            btxt = (btn.text() or "").strip()
            if "Center" in btxt and "Fit" in btxt:
                try:
                    btn.clicked.disconnect()
                except Exception:
                    pass
                btn.clicked.connect(_readable_center_fit)

                parent_lay = btn.parentWidget().layout() if btn.parentWidget() else None
                if isinstance(parent_lay, QHBoxLayout):
                    btn_z_out = QPushButton("- Zoom Out")
                    btn_z_out.setFixedWidth(85)
                    btn_z_out.clicked.connect(lambda: self._mm_zoom_filter._apply_zoom_factor(1.0 / 1.2))

                    btn_z_100 = QPushButton("100% Reset")
                    btn_z_100.setFixedWidth(85)
                    btn_z_100.clicked.connect(_readable_center_fit)

                    btn_z_in = QPushButton("+ Zoom In")
                    btn_z_in.setFixedWidth(85)
                    btn_z_in.clicked.connect(lambda: self._mm_zoom_filter._apply_zoom_factor(1.2))

                    idx = parent_lay.indexOf(btn)
                    parent_lay.insertWidget(idx, btn_z_out)
                    parent_lay.insertWidget(idx + 1, btn_z_100)
                    parent_lay.insertWidget(idx + 2, btn_z_in)
                break

        self._mind_map_enhanced = True

    def _ensure_v19_tabs_and_signals(self):
        from PyQt6.QtWidgets import QTabWidget
        from core.injector import DOMInjector
        from core.project_manager import ProjectManager

        target_tab_widget = None
        for tw in self.findChildren(QTabWidget):
            for i in range(tw.count()):
                if "Execution Flow" in tw.tabText(i) or "Task Queue" in tw.tabText(i):
                    target_tab_widget = tw
                    break
            if target_tab_widget:
                break

        _inj = getattr(self, "injector", None) or getattr(self, "dom_injector", None) or DOMInjector()
        _pm = getattr(self, "project_mgr", None) or getattr(self, "project_manager", None) or ProjectManager()
        self.project_mgr = _pm

        if target_tab_widget is not None:
            existing_titles = [target_tab_widget.tabText(i) for i in range(target_tab_widget.count())]
            if not hasattr(self, "file_vault_tab") or "Project Files & Context Vault" not in existing_titles:
                self.file_vault_tab = ProjectFileVaultTab(
                    injector=_inj,
                    get_panes_fn=lambda: getattr(self, "panes", {}),
                    get_project_fn=self._get_active_project_dict,
                    save_project_fn=_pm.save_project,
                    parent=self
                )
                self.file_vault_tab.recommendations_updated.connect(self._refresh_relay_vault_bar)
                target_tab_widget.addTab(self.file_vault_tab, "Project Files & Context Vault")

            if not hasattr(self, "model_monitor_tab") or "Model Modes & Usage Monitor" not in existing_titles:
                self.model_monitor_tab = ModelEfficiencyMonitorTab(
                    get_panes_fn=lambda: getattr(self, "panes", {}),
                    parent=self
                )
                target_tab_widget.addTab(self.model_monitor_tab, "Model Modes & Usage Monitor")

            # Mount Recommended Vault Files bar inside Execution Flow & File Relay tab
            self._inject_relay_vault_bar(target_tab_widget)

        for acc_id, pane in getattr(self, "panes", {}).items():
            try:
                pane.move_requested.disconnect(self._on_move_pane_requested)
            except Exception:
                pass
            pane.move_requested.connect(self._on_move_pane_requested)

        if hasattr(self, "file_vault_tab"):
            self.file_vault_tab.refresh_targets_and_view()
        if hasattr(self, "model_monitor_tab"):
            self.model_monitor_tab.rebuild_node_rows()
        self._refresh_relay_vault_bar()

        # Remove any horizontal spacer items in the browser strip layout so 2-3 panes expand to 100% width
        if getattr(self, "panes", None):
            first_pane = next(iter(self.panes.values()))
            strip_lay = self._get_strip_layout(first_pane)
            if strip_lay is not None:
                for i in reversed(range(strip_lay.count())):
                    item = strip_lay.itemAt(i)
                    if item and item.spacerItem() is not None:
                        strip_lay.takeAt(i)
                for p in self.panes.values():
                    strip_lay.setStretchFactor(p, 1)

        self._enhance_mind_map_zoom_and_fit()
        self._refresh_relay_stage_reorder_list()


# --- v1.9 Runtime Hooks (Init, Workspace Load, Master Directive Manifest, Close Popup) ---
_orig_mw_init = MainWindow.__init__
def _patched_mw_init(self, *args, **kwargs):
    _orig_mw_init(self, *args, **kwargs)
    self._ensure_v19_tabs_and_signals()
MainWindow.__init__ = _patched_mw_init

if hasattr(MainWindow, "_load_initial_workspace"):
    _orig_load_ws = MainWindow._load_initial_workspace
    def _patched_load_ws(self, *args, **kwargs):
        res = _orig_load_ws(self, *args, **kwargs)
        self._ensure_v19_tabs_and_signals()
        return res
    MainWindow._load_initial_workspace = _patched_load_ws

if hasattr(MainWindow, "_mount_project"):
    _orig_mount_proj = MainWindow._mount_project
    def _patched_mount_proj(self, *args, **kwargs):
        res = _orig_mount_proj(self, *args, **kwargs)
        self._ensure_v19_tabs_and_signals()
        return res
    MainWindow._mount_project = _patched_mount_proj

def _patched_close_event(self, event):
    if not self._confirm_unsaved_project():
        event.ignore()
        return
    if hasattr(self, "_clear_existing_panes"):
        try:
            self._clear_existing_panes()
        except Exception:
            pass
    event.accept()
MainWindow.closeEvent = _patched_close_event


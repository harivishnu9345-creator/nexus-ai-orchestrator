{
  "app": {
    "name": "Nexus AI Orchestrator",
    "version": "1.9.0",
    "storage_root": "~/.nexus_orchestrator",
    "default_zoom": 0.75
  },
  "platforms": {
    "claude": {
      "home_url": "https://claude.ai/new",
      "selectors": {
        "input_box": "div[contenteditable='true'], .ProseMirror, fieldset div[contenteditable='true']",
        "send_button": "button[aria-label*='Send' i], button[data-testid='send-button']",
        "stop_button": "button[aria-label*='Stop' i]"
      }
    },
    "gemini": {
      "home_url": "https://gemini.google.com/app",
      "selectors": {
        "input_box": "rich-textarea div.ql-editor, rich-textarea [contenteditable='true'], div[contenteditable='true'][role='textbox'], div[contenteditable='true']",
        "send_button": "button.send-button:not([disabled]), button[aria-label*='Send' i]:not([disabled]), button[mattooltip*='Send' i]:not([disabled])",
        "stop_button": "button[aria-label*='Stop' i], button[mattooltip*='Stop' i]"
      }
    }
  }
}
